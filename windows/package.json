{
  "name": "hunao-autodl",
  "productName": "胡闹AutoDL",
  "version": "1.2.0",
  "description": "AutoDL 实例监控与自动开机工具（Windows）",
  "author": "A2ureeE",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/zhuhaoxiang1/CrazyAutoDL-v2",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuhaoxiang1/CrazyAutoDL-v2.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hunao.autodl",
    "productName": "胡闹AutoDL",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "HuNaoAutoDL-${version}-win-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "胡闹AutoDL",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
